# Copiar a .env para desarrollo local (no versionar .env).
DATABASE_URL=postgres://gym:gym@localhost:5432/gym_dev
# Base exclusiva de los tests de integración (npm run test:int). Debe contener "test" en el nombre.
TEST_DATABASE_URL=postgres://gym:gym@localhost:5432/gym_test
# Obligatorio. Generar uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Zona horaria de presentación del gimnasio (las fechas se guardan en UTC)
APP_TIMEZONE=America/Montevideo
